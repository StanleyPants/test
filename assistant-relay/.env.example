# Assistant Relay — environment configuration (Phase 1)

# HTTP
PORT=8787

# Postgres connection (the relay owns this store; see spec §1.2)
DATABASE_URL=postgres://relay:relay@localhost:5432/assistant_relay

# OAuth 2.1 (authorization code + PKCE) against the org IdP.
# Every relay call must carry an end-user identity (spec §4).
# The relay validates bearer tokens against this issuer's JWKS.
OAUTH_ISSUER=https://idp.example.com/
OAUTH_AUDIENCE=assistant-relay
OAUTH_JWKS_URI=https://idp.example.com/.well-known/jwks.json

# DEV ONLY: when true, skip token verification and trust the
# X-Relay-User header as the caller identity. Never enable in prod.
DEV_TRUST_HEADER=false

# Notification push (spec §8). Slack DM preferred, email fallback.
# Leave blank in Phase 1 to log notifications to stdout instead.
SLACK_BOT_TOKEN=
NOTIFY_EMAIL_FROM=

# Lifecycle ceilings (hours/seconds) — defaults match spec §6.
EXPIRE_T2_HOURS=72

# Rate limits per (from_user,to_user) per hour (spec §10.4).
RATE_LIMIT_T2_PER_HOUR=5

# Loop/depth control (spec §10.3).
MAX_DEPTH=2
